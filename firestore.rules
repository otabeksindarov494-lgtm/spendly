rules_version = '2';

// Spendly — Firestore xavfsizlik qoidalari.
//
// Uch xil ma'lumot bor:
//   users/{uid}          — SHAXSIY: maosh, davomat, qarzlar. Faqat egasi.
//   publicProfiles/{uid} — OCHIQ: faqat ism va kichik avatar. Chat ro'yxati
//                          uchun kerak. Egasi yozadi, kirgan har kim o'qiydi.
//   chats/{chatId}       — Faqat suhbat ishtirokchilari.
//
// Joylashtirish: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // --- Shaxsiy ma'lumotlar (PROJECT.md 3.3) -------------------------------
    // Maosh, davomat, qarzlar — boshqa hech kim ko'ra olmaydi.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // --- Ochiq profil: chat ro'yxatidagi ism va avatar ----------------------
    // Ataylab alohida kolleksiya: users/{uid} ni ochib qo'yilsa, hamma
    // bir-birining maoshi va davomatini ko'rib qolardi.
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // --- Suhbatlar ---------------------------------------------------------
    // `participants` — ikkala tomonning uid'i. Ishtirokchi bo'lmagan odam
    // suhbatni ham, xabarlarni ham ko'ra olmaydi.
    match /chats/{chatId} {
      allow read: if signedIn()
                  && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants ==
                       resource.data.participants;
      allow delete: if false;

      // Xabar hujjatida ham `participants` saqlanadi — shunda qoidada
      // get() chaqirish shart emas (har o'qishda qo'shimcha xarajat bo'lardi).
      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in resource.data.participants;

        allow create: if signedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in
                         request.resource.data.participants
                      && request.resource.data.participants.size() == 2
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;

        // Xabarni faqat muallifi o'chira/tahrirlay oladi.
        allow update, delete: if signedIn()
                              && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
